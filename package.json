{
  "name": "oc-ad-bye-pass",
  "private": true,
  "version": "0.9.7",
  "type": "module",
  "description": "\uad11\uace0 \ucc28\ub2e8 \ud655\uc7a5 (MV3) \u2014 Chrome \u00b7 Edge \u00b7 Orion",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "vite build && node scripts/build-content.mjs",
    "build:orion": "TARGET=orion npm run build",
    "build:all": "npm run build && npm run build:orion",
    "dev": "node scripts/dev.mjs",
    "check": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:e2e": "npm run build:all && playwright test",
    "test:all": "npm run check && npm test && npm run build:all && npm run verify && playwright test",
    "icons": "node scripts/make-icons.mjs",
    "zip": "npm run build && npm run verify && cd dist && zip -qr ../oc-ad-bye-pass.zip . && cd .. && echo 'oc-ad-bye-pass.zip'",
    "check:orion": "node scripts/check-orion-api.mjs",
    "audit": "npm run build && node scripts/audit-ads.mjs",
    "verify": "node scripts/verify-build.mjs",
    "og": "node scripts/build-og.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}

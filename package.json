{
  "name": "oc-ad-bye-pass",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "YouTube 전용 광고 차단 Chrome 확장 (MV3)",
  "scripts": {
    "build": "vite build && node scripts/build-content.mjs",
    "dev": "node scripts/dev.mjs",
    "check": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run check && npm test && npm run test:e2e",
    "icons": "node scripts/make-icons.mjs",
    "zip": "npm run build && cd dist && zip -qr ../oc-ad-bye-pass.zip . && cd .. && echo 'oc-ad-bye-pass.zip'"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}

{
  "manifest_version": 3,
  "name": "OC Ad Bye-Pass",
  "version": "0.10.1",
  "description": "\uad11\uace0 \ucc28\ub2e8\uae30. \uc720\ud29c\ube0c\ub294 \uc751\ub2f5 \ub2e8\uacc4\uc5d0\uc11c \uad11\uace0\ub97c \ub9c9\uace0, \ub2e4\ub978 \uc0ac\uc774\ud2b8\ub294 \uad11\uace0\ub9dd \uc694\uccad\uc744 \ucc28\ub2e8\ud569\ub2c8\ub2e4.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "declarativeNetRequest",
    "scripting"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://gist.githubusercontent.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "isolated.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OC Ad Bye-Pass"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules/ads.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "main.js"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ]
    }
  ]
}
